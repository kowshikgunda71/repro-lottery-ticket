FROM docker.io/library/python:3.12-slim
# CPU-only wheels; the run has NO network, so everything ships in the image.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.7.1 \
 && pip install --no-cache-dir numpy==2.2.6 scipy==1.15.3 scikit-learn==1.6.1 pandas==2.2.3 pyarrow==19.0.1
